{
  "name": "ferric-fx",
  "version": "1.0.0",
  "private": true,
  "description": "Static p5.js FX processor app.",
  "scripts": {
    "check": "npm run lint && npm run format:check",
    "lint": "npm run lint:js && npm run lint:html",
    "lint:fix": "npm run lint:js -- --fix && npm run format",
    "lint:js": "eslint \"src/**/*.js\"",
    "lint:html": "htmlhint \"*.html\"",
    "format": "prettier --write \"*.html\" \"src/**/*.js\"",
    "format:check": "prettier --check \"*.html\" \"src/**/*.js\""
  },
  "devDependencies": {
    "eslint": "^9.29.0",
    "htmlhint": "^1.5.1",
    "prettier": "^3.5.3"
  }
}
